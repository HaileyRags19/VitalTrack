# API
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Auth0 (API)
AUTH0_AUDIENCE=https://api.vitaltrack.yourdomain
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com/
AUTH0_ROLES_CLAIM=https://vitaltrack.app/roles

# PostgreSQL: the app role used at runtime (no schema changes allowed)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vitaltrack
DB_USER=vitaltrack_app
DB_PASSWORD=change_me

# PostgreSQL owner: only used by `npm run db:init`
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=change_me

# Client (Vite): Auth0 single-page application
VITE_AUTH0_DOMAIN=YOUR_TENANT.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://api.vitaltrack.yourdomain
